{
  "manifest_version": 3,
  "name": "SPDT - Bantu Entri (Auto Save + Backup + Rekap)",
  "version": "1.9.0",
  "description": "Penanda baris aktif, auto-save berkala, titik jadi koma desimal, backup draf dokumen ke file, dan unduh rekap entry selesai per operator per hari.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://spdtntp.web.bps.go.id/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pengaturan Bantu Entri SPDT",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://spdtntp.web.bps.go.id/*"],
      "js": ["backup-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://spdtntp.web.bps.go.id/*"],
      "js": ["content.js", "entry-helpers.js", "autosave.js", "rekap-bridge.js", "backup.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
