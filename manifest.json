{
  "manifest_version": 3,
  "name": "SPDT - Bantu Entri (Freeze Komoditas + Auto Save)",
  "version": "1.3.0",
  "description": "Freeze kolom komoditas, penanda baris aktif, auto-save berkala (durasi diatur), Enter pindah input, dan titik jadi koma desimal.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pengaturan Bantu Entri SPDT",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://spdtntp.web.bps.go.id/*"],
      "js": ["content.js", "entry-helpers.js", "autosave.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
